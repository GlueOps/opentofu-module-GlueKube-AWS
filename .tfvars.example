# Example .tfvars file for GlueKube AWS module

provider_credentials = {
  name       = "aws"
  access_key = "AKIAXXXXXXXXXXXXXXXX"
  secret_key = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  region     = "us-west-2"
}

region = "us-west-2"

vpc_cidr_block = "10.0.0.0/16"

# Public subnets across 3 availability zones
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]

# Private subnets across 3 availability zones
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]

gluekube_docker_image = "ghcr.io/glueops/gluekube"
gluekube_docker_tag   = "v0.0.12"

bastion = {
  instance_type = "t3a.small"
  image         = "" # Leave empty to use latest Ubuntu 24.04
}

autoglue = {
  autoglue_cluster_name = "demo-cluster"

  credentials = {
    autoglue_key        = "your-autoglue-key"
    autoglue_org_secret = "your-autoglue-org-secret"
    base_url            = "https://autoglue.glueopshosted.com/api/v1"
  }

  route_53_config = {
    aws_access_key_id     = "AKIAXXXXXXXXXXXXXXXX"
    aws_secret_access_key = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    aws_region            = "us-west-2"
    domain_name           = "example.com"
    zone_id               = "Z1234567890ABC"
    credential_id         = "your-credential-id"
  }
}

node_pools = [
  {
    name              = "masters"
    image             = "" # Leave empty to use latest Ubuntu 24.04
    node_count        = 3
    instance_type     = "t3a.xlarge"
    role              = "master"
    kubernetes_labels = {}
    kubernetes_taints = []
  },
  {
    name              = "workers"
    image             = ""
    node_count        = 3
    instance_type     = "t3a.xlarge"
    role              = "worker"
    kubernetes_labels = {
      "node-role" = "worker"
    }
    kubernetes_taints = []
  },
  {
    name              = "public-lb"
    image             = ""
    node_count        = 2
    instance_type     = "t3a.large"
    role              = "worker"
    kubernetes_labels = {
      "use-as-loadbalancer" = "public"
    }
    kubernetes_taints = [
      {
        key    = "glueops.dev/role"
        value  = "glueops-platform"
        effect = "NoSchedule"
      }
    ]
  }
]
